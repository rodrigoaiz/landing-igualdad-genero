---
import type { FeaturedVideo } from "../types/landing";
import FeaturedVideoSection from "./FeaturedVideoSection.astro";

interface Props {
  videos: readonly FeaturedVideo[];
}

const { videos } = Astro.props;
---

<section id="videos" class="video-library">
  <div class="video-intro bg-paper py-20 sm:py-28">
    <div class="video-intro-grid container-page grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-10">
      <div class="video-intro-copy">
        <h2 class="section-title">Te ofrecemos video tutoriales para usar Moodle</h2>
        <div class="lg:pt-3">
          <p class="body-copy">Empieza por la duda que tienes y sigue los pasos para resolverla.</p>
          <p class="mt-5 max-w-xl border-t border-coral pt-4 font-bold">Consulta los videos en el orden que aparecen para seguir una guía completa. </p>
        </div>
      </div>
      <div class="video-intro-art">
        <img src="/assets/illustrations/mujer-celular.webp" alt="Estudiante consultando Moodle desde su celular" width="1180" height="1333" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>

  {videos.map((video) => <FeaturedVideoSection video={video} />)}
</section>
