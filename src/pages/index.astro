---
import BaseLayout from "../layouts/BaseLayout.astro";
import AssignmentSection from "../components/AssignmentSection.astro";
import ClosingSection from "../components/ClosingSection.astro";
import HelpSection from "../components/HelpSection.astro";
import HeroSection from "../components/HeroSection.astro";
import ProofStrip from "../components/ProofStrip.astro";
import QuickRoute from "../components/QuickRoute.astro";
import ResourceRepository from "../components/ResourceRepository.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import VideoLibrary from "../components/VideoLibrary.astro";
import { externalResources, featuredVideos, routeSteps } from "../data/landing";
---

<BaseLayout
  title="Moodle para Igualdad de Género | Guía para CCH"
  description="Guía para estudiantes del CCH: cómo ingresar a Igualdad de Género en Moodle, entregar actividades, participar en foros y consultar resultados."
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="scroll-progress" aria-hidden="true"></div>

  <SiteHeader />

  <main id="contenido">
    <HeroSection />
    <ProofStrip />
    <AssignmentSection />
    <QuickRoute steps={routeSteps} />
    <VideoLibrary videos={featuredVideos} />
    <ResourceRepository resources={externalResources} />
    <HelpSection />
    <ClosingSection />
  </main>

  <SiteFooter />

  <script>
    import { initLanding } from "../scripts/landing";
    initLanding();
  </script>
</BaseLayout>
